# Copie para .env e ajuste se necessário. NENHUMA chave é obrigatória.
# Time alvo do MVP (Santa Cruz Futebol Clube - PE)
SANTACRUZ_TEAM_ID=1976

# Temporada usada nas análises e no Índice de Performance (Série C 2026)
SANTACRUZ_SEASON_YEAR=2026

# Quantas páginas de histórico buscar no Sofascore (30 jogos por página)
COLLECT_MAX_PAGES=3

# Pausa entre requisições (segundos) — educado com a fonte
HTTP_THROTTLE_SECONDS=0.35

# Host da API do Sofascore (fallbacks: www.sofascore.com, api.sofascore.app)
SOFASCORE_HOST=https://api.sofascore.com
